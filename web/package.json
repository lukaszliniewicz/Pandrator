{
  "name": "pandrator-web",
  "private": true,
  "version": "0.6.7",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "dead-code": "cross-env KNIP_DISABLE_RAW_TRANSFER=1 knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate-api": "openapi-typescript ../openapi.json --default-non-nullable false -o src/lib/api.generated.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "quality": "npm run format:check && npm run lint && npm run check && npm run dead-code",
    "test:a11y": "playwright test tests/accessibility.spec.ts",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.48.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^26.1.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.8.0",
    "knip": "^6.29.0",
    "openapi-typescript": "^7.10.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.45.0",
    "svelte-check": "^4.3.4",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.2.4"
  },
  "dependencies": {
    "@lucide/svelte": "^0.562.0",
    "pdfjs-dist": "^5.4.394"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "cookie": "0.7.2"
  }
}
