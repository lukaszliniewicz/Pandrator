{
  "name": "pandrator-web",
  "private": true,
  "version": "0.14.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:manager-models && vite build",
    "check": "npm run check:manager-models && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "dead-code": "cross-env KNIP_DISABLE_RAW_TRANSFER=1 knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate-api": "openapi-typescript ../openapi.json --default-non-nullable false -o src/lib/api.generated.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "quality": "npm run format:check && npm run lint && npm run check && npm run dead-code",
    "test:unit": "node --test \"unit-tests/*.test.mjs\"",
    "test:a11y": "playwright test tests/accessibility.spec.ts",
    "test:e2e": "playwright test",
    "build:manager-models": "node scripts/build-manager-model-groups.mjs",
    "check:manager-models": "node scripts/build-manager-model-groups.mjs --check",
    "check:assets": "node scripts/check-static-assets.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "cross-env": "^10.1.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.14.0",
    "knip": "^6.44.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7"
  },
  "dependencies": {
    "@lucide/svelte": "^0.562.0",
    "pdfjs-dist": "6.4.299"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "cookie": "0.7.2",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.20"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
