# Include inside an HTTPS server that restricts ingress to Cloudflare's published ranges.
# Install/update set_real_ip_from entries in the referenced include; never trust all peers.
# Requires nginx's http_realip_module. TLS certificate/server_name configuration is external.
include /etc/nginx/snippets/cloudflare-realip.conf;
real_ip_header CF-Connecting-IP;
real_ip_recursive on;

location / {
    proxy_pass http://127.0.0.1:8097;
    proxy_set_header Host pandrator.example.com;
    proxy_set_header X-Forwarded-Host pandrator.example.com;
    proxy_set_header X-Forwarded-Proto https;
    # Flatten the verified address to one value: Pandrator trusts exactly one proxy hop.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 3600s;
    # Set an explicit upload budget appropriate for your recordings.
    client_max_body_size 10g;
}
